# 大模型配置（DeepSeek，OpenAI 兼容接口）
# 复制本文件为 .env 后填入真实值；本文件只放占位符，禁止写真实凭据
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
# 推理模型开关：disabled 关掉思考链（更快，且不会把 max_tokens 吃光）
LLM_THINKING=disabled
LLM_MAX_TOKENS=2048

# 应用配置
NODE_ENV=production
PORT=8080

# 访问口令：⚠️ 必填，且**绝不能**把真实值写进任何纳入 git 的文件。
# 未配置时 /api/chat 与 /api/verify-password 一律拒绝（fail-closed），
# 不会退化回任何默认口令——口令一旦进公开仓库，等于把「会扣上游费用的入口」公开。
# 线上走 GitHub Secret → 工作流 → flyctl secrets set，不要用 fly.toml 的 [env] 承载。
ACCESS_PASSWORD=

# 限流（可选，以下为默认值）
# 每 IP 10 分钟窗口内的对话次数 / 口令校验次数；RATE_DAILY_MAX 为全站日总量兜底
RATE_CHAT_MAX=20
RATE_VERIFY_MAX=10
RATE_DAILY_MAX=300
# 单条提问字数上限
MSG_MAX_LEN=500
